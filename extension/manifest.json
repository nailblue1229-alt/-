{
  "manifest_version": 3,
  "name": "샤오홍슈 일괄 다운로더",
  "version": "1.1.0",
  "description": "목록 카드의 ⬇ 버튼으로 하나씩 받거나, 노트를 열어 받습니다. (v1.1 카드 버튼)",
  "permissions": [
    "tabs",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://*.xhscdn.com/*",
    "https://*.xiaohongshu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "샤오홍슈 일괄 다운로더 열기"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "extract.js",
        "content.js",
        "cards.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
